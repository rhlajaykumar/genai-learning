# AI service — local secrets (never commit)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ~16GB VRAM: nomic-embed-text (~0.6GB) + qwen3:8b (~5–8GB at num_ctx=8192)
# Avoid llama3.1:latest — Ollama defaults to 65536 ctx and can use ~17GB alone.
TEXT_MODEL=qwen3:8b
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
OLLAMA_NUM_CTX=8192
OLLAMA_EMBED_NUM_CTX=2048
OLLAMA_KEEP_ALIVE=10m

# Smaller/faster chat (fits easily): TEXT_MODEL=llama3.2:1b

# Optional Google provider (set LLM_PROVIDER=google)
GOOGLE_API_KEY=

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/booking
JWT_SECRET=dev-only-change-me-to-a-long-random-secret
RETRIEVER_BACKEND=pgvector
UPLOAD_DIR=uploads
